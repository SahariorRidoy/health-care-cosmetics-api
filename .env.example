NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hcc-erp
# or Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/hcc-erp

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ACCESS_SECRET=<generate_64_byte_hex_secret>
JWT_REFRESH_SECRET=<generate_64_byte_hex_secret_different_from_above>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
